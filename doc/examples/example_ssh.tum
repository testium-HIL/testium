main:
    name: Test ssh
    version: 0.1
    stop_on_failure: False
    steps:

        - console:
            name: Console creation
            console_name: consname
            doc: Opening the console
            steps:
                - open:
                    protocol: ssh
                    ssh_host: "my_hostname"
                    ssh_user: "francois"

        - console:
            name: Console commands
            console_name: consname
            doc: Runs commands over ssh and checks a file content.
            steps:
                - exec: rm -f /tmp/toto.txt
                - exec: touch /tmp/toto.txt
                - exec: echo "blablabla" >> /tmp/toto.txt
                - exec:
                    cmd: cat /tmp/toto.txt
                    timeout: 10
                    process_result: "'blablabla' in r'''$(result)'''"

        - console:
            name: Console deletion
            console_name: consname
            doc: Closing the console
            steps:
                - close: consname
