
- console:
    name: Console creation
    console_name: term
    doc: Opening the console
    key: $(test)_PASS
    steps:
        - open:
            protocol: terminal
            terminal_path: $(test_directory)
{% if os == "Linux" %}
        - writeln: echo "endOfOpen"
{% endif %}

- console:
    name: Console read_until with timeout
    console_name: term
    key: $(test)_PASS
    steps:
{% if os == "Linux" %}
        - read_until: {expected: endOfOpen, timeout: 5}
{% else %}
        - read_until: {expected: $(terminal_prompt), timeout: 5}
{% endif %}

- console:
    name: Console write
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo 0

- sleep:
    name: sleep item
    timeout: 1

- console:
    name: Console read_until immediate
    console_name: term
    key: $(test)_PASS
    steps:
{% if os == "Windows" %}
        - read_until: {expected: "echo 0", timeout: 0}
{% endif %}
        - read_until: {expected: "0", timeout: 0}

- console:
    name: Console write
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "HelloConsole"

- console:
    name: Console read_until fail
    console_name: term
    key: $(test)_FAIL
    steps:
        - read_until: {expected: "Something never prints", timeout: 1}

- console:
    name: Console write
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "HelloConsole"

- console:
    name: Console read_until no_fail
    console_name: term
    key: $(test)_PASS
    steps:
        - read_until: {expected: Something never prints, timeout: 1, no_fail: true}

- console:
    name: Console read_until muted
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "HelloConsole"
{% if os == "Windows" %}
        - read_until: {expected: echo "HelloConsole", timeout: 1, mute: true}
{% endif %}
        - read_until: {expected: HelloConsole, timeout: 1, mute: true}

- console:
    name: Console read_until float timeout
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "HelloConsole"
{% if os == "Windows" %}
        - read_until: {expected: echo "HelloConsole", timeout: 0.2}
{% endif %}
        - read_until: {expected: HelloConsole, timeout: 0.2}

- console:
    name: Console exec process result
    doc: exec synchronizes on its own marker, no OS branch needed.
    console_name: term
    key: $(test)_PASS
    steps:
        - exec: {cmd: echo "HelloConsole is PASS", timeout: 5, process_result: "<| 'Hello' in r'''$(result)''' and 'PASS' in r'''$(result)''' |>"}

{% if os == "Linux" %}
- console:
    name: Console runs on host (not the Flatpak sandbox)
    doc: Regression guard for the 0.2.1 Flatpak bug (term console spawned inside the sandbox instead of on the host). /.flatpak-info exists only inside the sandbox, so the host-only marker is emitted (and matched by read_until) ONLY when the shell really runs on the host. On a broken Flatpak the marker never appears, read_until times out and the item FAILS. The marker is built at runtime ($M) so it is never present in the command line itself. Passes on every other channel.
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: 'test -e /.flatpak-info && M=SANDBOX || M=HOST; echo "console_host_check_$M"'
        - read_until: {expected: console_host_check_HOST, timeout: 5}
{% endif %}

# --- read_until matching a list of values (succeeds on any) ---
- console:
    name: Console read_until list match any
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "list_marker_B"
        - read_until: {expected: [list_marker_A, list_marker_B, list_marker_C], timeout: 5}

- console:
    name: Console read_until list no match
    console_name: term
    key: $(test)_FAIL
    steps:
        - read_until: {expected: [never_marker_A, never_marker_B], timeout: 1}

# --- read_until with regular expressions ---
- console:
    name: Console read_until regex
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "regex_val_4242_end"
        - read_until: {expected: 'regex_val_\d+_end', regex: true, timeout: 5}

- console:
    name: Console read_until regex list any
    console_name: term
    key: $(test)_PASS
    steps:
        - writeln: echo "STATUS=ready"
        - read_until: {expected: ['ERR:.*', 'STATUS=(ready|busy)'], regex: true, timeout: 5}

- console:
    name: Console read_until regex no match
    console_name: term
    key: $(test)_FAIL
    steps:
        - read_until: {expected: 'never_\d{4}', regex: true, timeout: 1}

# --- exec: command with completion marker ----------------------------------

- console:
    name: Console exec scalar form
    console_name: term
    key: $(test)_PASS
    steps:
        - exec: echo exec_scalar_ok

- console:
    name: Console exec chained keeps the stream clean
    doc: Each exec reads its own output; no marker or output of the first may leak into the second.
    console_name: term
    key: $(test)_PASS
    steps:
        - exec: {cmd: echo exec_first, timeout: 5, process_result: "<| 'exec_first' in r'''$(result)''' |>"}
        - exec: {cmd: echo exec_second, timeout: 5, process_result: "<| 'exec_second' in r'''$(result)''' and 'exec_first' not in r'''$(result)''' |>"}

- console:
    name: Console open without dialect
    doc: dialect 'none' on purpose; exec must refuse with a clear message.
    console_name: device
    key: $(test)_PASS
    steps:
        - open:
            protocol: terminal
            terminal_path: $(test_directory)
            dialect: none

- console:
    name: Console exec without dialect (explicit failure)
    console_name: device
    key: $(test)_FAIL
    steps:
        - exec: echo refused

- console:
    name: Console without dialect closure
    console_name: device
    key: $(test)_PASS
    steps:
        - close: device

- console:
    name: Console exec timeout (explicit failure)
    console_name: term
    key: $(test)_FAIL
    steps:
{% if os == "Windows" %}
        - exec: {cmd: ping -n 6 127.0.0.1 >NUL, timeout: 1}
{% else %}
        - exec: {cmd: sleep 5, timeout: 1}
{% endif %}

# --- Explicit error reporting for .tum misconfigurations -------------------
# These exercise the clean-failure paths: a misconfigured console must FAIL
# with an explicit message, never crash the suite with a Python traceback.

- console:
    name: Console read on a never-opened console (explicit failure)
    doc: read_until on a console whose 'open' never ran must FAIL with a clear "not open" message, not crash with 'NoneType' has no attribute 'read_until'.
    console_name: never_opened
    key: $(test)_FAIL
    steps:
        - read_until: {expected: anything, timeout: 1}

- console:
    name: Console write on a never-opened console (explicit failure)
    console_name: never_opened
    key: $(test)_FAIL
    steps:
        - writeln: echo nothing

- console:
    name: Console open with empty console_name (explicit failure)
    doc: An empty console_name reaches the Console constructor as None; it must FAIL with an explicit "console_name is missing/empty" message, not a cryptic TypeError.
    console_name:
    key: $(test)_FAIL
    steps:
        - open: {protocol: terminal, terminal_path: $(test_directory)}

{% if os == "Linux" %}
# --- SSH transport -----------------------------------------------------------
# No SSH server is assumed: connecting to an unreachable host must FAIL cleanly
# (one-line message, no traceback), and a follow-up read on that console must
# also FAIL explicitly — the exact open-fails-then-read cascade that used to
# crash the runner.
- console:
    name: SSH open to an unreachable host (explicit failure)
    doc: Uses the reserved .invalid TLD (guaranteed not to resolve) so the login fails fast. Must FAIL with a clear "SSH login failed" message.
    console_name: ssh_unreachable
    key: $(test)_FAIL
    steps:
        - open:
            protocol: ssh
            ssh_host: testium-validation.invalid
            ssh_user: nobody

- console:
    name: SSH read after a failed open (explicit failure)
    doc: The 'open' above failed, so this console is not registered; read_until must FAIL with the explicit "not open" message instead of crashing.
    console_name: ssh_unreachable
    key: $(test)_FAIL
    steps:
        - read_until: {expected: anything, timeout: 1}
{% endif %}

# --- read_until vs pre-buffered data (Zephyr "OK" scenario) ------------------
# A device where every command is answered by "OK": the campaign writes a
# command then read_until "OK". If the previous answer was never read it is
# still buffered, and the next read_until matches that stale answer instead
# of the new command's answer: the captured data misses the new command's
# output (the campaign runs ahead of the board). The check below is RED as
# long as read_until can match text received before the action started; when
# the `flush` console action lands, a `flush` step is inserted in the "second
# command" item (before the writeln) and the scenario turns GREEN.
- console:
    name: Console stale OK open
    console_name: stale_ok
    key: $(test)_PASS
    steps:
        - open:
            protocol: terminal
            terminal_path: $(test_directory)

- console:
    name: Console stale OK first answer left unread
    console_name: stale_ok
    key: $(test)_PASS
    steps:
        - writeln: echo OK

- sleep:
    name: Console stale OK settle
    timeout: 1

- console:
    name: Console stale OK second command
    doc: read_until OK must wait for THIS command's answer, so the captured data must contain its output.
    console_name: stale_ok
    key: $(test)_PASS
    steps:
{% if os == "Linux" %}
        - writeln: echo STALE_SECOND_OUT; echo OK
{% else %}
        - writeln: 'echo STALE_SECOND_OUT& echo OK'
{% endif %}
        - read_until: {expected: OK, timeout: 5}

- check:
    name: Console stale OK captured data holds the second output
    key: $(test)_PASS
    values:
        - <| 'STALE_SECOND_OUT' in r'''$(cn_Console stale OK second command)''' |>

- console:
    name: Console stale OK closure
    execute_on_stop: true
    console_name: stale_ok
    key: $(test)_PASS
    steps:
        - close: stale_ok

# --- console log line timestamps (reception time vs drain time) --------------
# A shell loop emits tsline_1/2/3 two seconds apart; the answers are left to
# accumulate in the console buffer (the settle), then ONE read_until drains
# them in a burst. The [HH:MM:SS name] stamps in the step log must keep the
# 2 s spacing between the lines — the reception time, the contract the file
# log already honours. Today the stream log stamps lines when the step
# displays them, so the three lines collapse onto the drain time; the
# cross-item check in items/report.tum (on the per-step JUnit log) is RED
# until the stamps carry the reception time.
- console:
    name: Console timestamp open
    console_name: tslog
    key: $(test)_PASS
    steps:
        - open:
            protocol: terminal
            terminal_path: $(test_directory)

- console:
    name: Console timestamp slow output
    doc: The loop runs in the shell; its answers are left unread so they pile up in the console buffer.
    console_name: tslog
    key: $(test)_PASS
    steps:
{% if os == "Linux" %}
        - writeln: for i in 1 2 3; do echo tsline_$i; sleep 2; done
{% else %}
        - writeln: for /l %i in (1,1,3) do (echo tsline_%i & timeout /t 2 /nobreak >nul)
{% endif %}

- sleep:
    name: Console timestamp settle
    timeout: 6

- console:
    name: Console timestamp buffered drain
    doc: All three answers are already buffered; one read_until drains them in a burst, and the report check verifies their stamps kept the 2 s spacing.
    console_name: tslog
    key: $(test)_PASS
    steps:
        - read_until: {expected: tsline_3, timeout: 10}

- console:
    name: Console timestamp closure
    execute_on_stop: true
    console_name: tslog
    key: $(test)_PASS
    steps:
        - close: tslog

- console:
    name: Console closure
    execute_on_stop: true
    console_name: term
    key: $(test)_PASS
    steps:
        - close: term
